"""Tests for rules_harbor.

- Analysis test verifies the macro instantiates cleanly.
- Smoke composition: kind cluster + Harbor install + an in-cluster
  pod running `crane` that pushes a synthetic OCI image to Harbor and
  pulls it back, asserting the layer payload round-trips byte-for-byte.
  Proves Harbor's HTTP API + auth + registry storage all work
  end-to-end — not "core pod is up".
"""

load("@rules_harbor//:defs.bzl", "harbor_health_check", "harbor_install")
load("@rules_itest//:itest.bzl", "itest_service", "service_test")
load("@rules_kind//:defs.bzl", "kind_cluster", "kind_health_check")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":analysis_tests.bzl", "harbor_install_test_suite")

# ---- analysis ---------------------------------------------------------------

harbor_install_test_suite(name = "harbor_install_analysis")

# ---- smoke composition ------------------------------------------------------

kind_cluster(name = "cluster", k8s_version = "1.32")
kind_health_check(name = "cluster_health", cluster = ":cluster")
itest_service(
    name = "kind_svc",
    exe = ":cluster",
    health_check = ":cluster_health",
    tags = ["manual"],
)

harbor_install(
    name = "harbor_install_bin",
    tags = ["manual"],
)

harbor_health_check(
    name = "harbor_health_bin",
    tags = ["manual"],
)

sh_binary(
    name = "harbor_install_wrapper",
    srcs = ["install_wrapper.sh"],
    data = [":harbor_install_bin"],
)

sh_binary(
    name = "harbor_health_wrapper",
    srcs = ["health_wrapper.sh"],
    data = [":harbor_health_bin"],
)

itest_service(
    name = "harbor_svc",
    exe = ":harbor_install_wrapper",
    deps = [":kind_svc"],
    health_check = ":harbor_health_wrapper",
    tags = ["manual"],
)

sh_test(
    name = "smoke_test_bin",
    srcs = ["smoke_test.sh"],
    tags = ["manual"],
)

service_test(
    name = "smoke_test",
    services = [":harbor_svc"],
    test = ":smoke_test_bin",
    tags = [
        "manual",
        "no-sandbox",
        "requires-network",
    ],
)
